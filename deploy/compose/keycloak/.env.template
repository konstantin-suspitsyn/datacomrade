# ----------------------------------------
# Шаблон .env для стека KEYCLOAK
# Скопировать в .env и заполнить секреты:
#   cp .env.template .env
# ----------------------------------------

# ----------------------------------------
# Postgres DB settings (отдельная база под Keycloak)
# ----------------------------------------
KEYCLOAK_POSTGRES_CONTAINER_NAME=keycloak_postgres
KEYCLOAK_POSTGRES_IMAGE=postgres:18.3-alpine3.23
KEYCLOAK_POSTGRES_USER=
KEYCLOAK_POSTGRES_PASSWORD=
KEYCLOAK_POSTGRES_DB=keycloak
# 5432 занят контейнером datacatalogue, поэтому наружу отдаём 5433
KEYCLOAK_POSTGRES_PORT=5433

# ----------------------------------------
# Keycloak server settings
# ----------------------------------------
KEYCLOAK_CONTAINER_NAME=keycloak
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.4
KEYCLOAK_HTTP_PORT=8081
KEYCLOAK_MGMT_PORT=9000
KEYCLOAK_HOSTNAME=localhost
KEYCLOAK_LOG_LEVEL=info

# ----------------------------------------
# Первичный администратор (только при первом старте на пустой БД)
# ----------------------------------------
KEYCLOAK_ADMIN_USER=
KEYCLOAK_ADMIN_PASSWORD=
