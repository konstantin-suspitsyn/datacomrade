# ----------------------------------------
# Шаблон .env для стека TEST_CLICKHOUSE
# Скопировать в .env и заполнить секреты:
#   cp .env.template .env
# ----------------------------------------
# Тестовая целевая СУБД типа ClickHouse — на ней query_engine проверяет
# рендер и выполнение SQL для диалекта clickhouse.
# ----------------------------------------

TEST_CLICKHOUSE_CONTAINER_NAME=test_clickhouse
TEST_CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:25.3-alpine

# ----------------------------------------
# Проброшенные порты
# HTTP  (8123) — clickhouse-client по HTTP, curl, UI
# Native (9000) — драйвер clickhouse-go/v2
# ----------------------------------------
TEST_CLICKHOUSE_HTTP_PORT=8123
TEST_CLICKHOUSE_NATIVE_PORT=9000

# ----------------------------------------
# Учётные данные
# ----------------------------------------
TEST_CLICKHOUSE_USER=query_engine_user
TEST_CLICKHOUSE_PASSWORD=pass
TEST_CLICKHOUSE_DB=query_engine
