# ----------------------------------------
# Шаблон .env для стека REDIS
# Скопировать в .env и заполнить секреты:
#   cp .env.template .env
# ----------------------------------------

# ----------------------------------------
# Redis server settings
# Один инстанс на все микросервисы, разделение — по namespace (префиксам ключей),
# а не по номеру логической БД (SELECT), чтобы не завязываться на него при переходе на Cluster.
# ----------------------------------------
REDIS_CONTAINER_NAME=datacomrade
REDIS_IMAGE=redis:7.4-alpine
REDIS_PORT=6379
REDIS_PASSWORD=password

# ----------------------------------------
# Память и вытеснение ключей
# allkeys-lru — вытесняем наименее используемые ключи любого сервиса при достижении лимита
# ----------------------------------------
REDIS_MAXMEMORY=256mb
REDIS_MAXMEMORY_POLICY=allkeys-lru
