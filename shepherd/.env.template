# ----------------------------------------
# Данные для микросервиса SHEPHERD (API Gateway)
# ----------------------------------------

# ----------------------------------------
# HTTP host and port
# ----------------------------------------
SHEPHERD_HTTP_PORT=${SHEPHERD_HTTP_PORT}

# ----------------------------------------
# Logger settings
# ----------------------------------------
SHEPHERD_LOGGER_LEVEL=${SHEPHERD_LOGGER_LEVEL}
SHEPHERD_LOGGER_AS_JSON=${SHEPHERD_LOGGER_AS_JSON}

# ----------------------------------------
# CORS: allowlist origin'ов фронтенда через запятую
# ----------------------------------------
SHEPHERD_CORS_ORIGINS=${SHEPHERD_CORS_ORIGINS}

# ----------------------------------------
# Keycloak: issuer realm'а, из него же вычисляется JWKS-адрес
# ----------------------------------------
SHEPHERD_KEYCLOAK_ISSUER_URL=${SHEPHERD_KEYCLOAK_ISSUER_URL}

# ----------------------------------------
# Swagger UI и /openapi.yaml — выключить в production
# ----------------------------------------
SHEPHERD_ENABLE_DOCS=${SHEPHERD_ENABLE_DOCS}

# ----------------------------------------
# Redis: адрес хоста свой (SHEPHERD_REDIS_HOST), порт и пароль — общие для
# всех микросервисов, см. deploy/compose/redis
# ----------------------------------------
SHEPHERD_REDIS_HOST=${SHEPHERD_REDIS_HOST}
REDIS_PORT=${REDIS_PORT}
REDIS_PASSWORD=${REDIS_PASSWORD}

# ----------------------------------------
# Данные для других микросервисов
# ----------------------------------------

# ----------------------------------------
# datacatalogue (Metadata Service): gRPC host and port
# ----------------------------------------
DATACATALOGUE_GRPC_HOST=${DATACATALOGUE_GRPC_HOST}
DATACATALOGUE_GRPC_PORT=${DATACATALOGUE_GRPC_PORT}
